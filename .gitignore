:root {
  --bg: #f7f1ea;
  --panel: rgba(255, 255, 255, 0.7);
  --panel-strong: #fffaf5;
  --primary: #b45309;
  --primary-deep: #7c2d12;
  --secondary: #0f766e;
  --secondary-soft: #dff7f5;
  --gold: #fbbf24;
  --text: #1f2937;
  --muted: #64748b;
  --stroke: rgba(15, 23, 42, 0.08);
  --shadow: 0 18px 40px rgba(136, 93, 31, 0.12);
}

html, body {
  margin: 0;
  min-height: 100%;
  font-family: Arial, Helvetica, sans-serif;
  background:
    radial-gradient(circle at top left, rgba(251, 191, 36, 0.28), transparent 20%),
    radial-gradient(circle at bottom right, rgba(15, 118, 110, 0.18), transparent 25%),
    var(--bg);
  color: var(--text);
}

* {
  box-sizing: border-box;
}

button,
input {
  font: inherit;
}

button {
  cursor: pointer;
}

body {
  min-height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 28px;
}

.maghreb-shell {
  width: min(1480px, 100%);
  min-height: 92vh;
  display: grid;
  grid-template-columns: 330px 1.2fr 380px;
  gap: 22px;
  background: rgba(255, 255, 255, 0.35);
  border: 1px solid rgba(120, 86, 32, 0.12);
  border-radius: 32px;
  backdrop-filter: blur(10px);
  box-shadow: var(--shadow);
  padding: 20px;
}

.sidebar,
.main-panel,
.right-panel {
  background: rgba(255, 255, 255, 0.42);
  border: 1px solid var(--stroke);
  border-radius: 24px;
}

.sidebar {
  padding: 18px 14px;
}

.brand-box {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 12px 10px 18px;
}

.brand-mark {
  width: 42px;
  height: 42px;
  border-radius: 16px;
  display: grid;
  place-items: center;
  font-weight: 700;
  color: white;
  background: linear-gradient(135deg, var(--primary), #f59e0b);
  box-shadow: 0 10px 20px rgba(180, 83, 9, 0.25);
}

.brand-name {
  font-size: 1.2rem;
  font-weight: 700;
  color: var(--primary-deep);
}

.brand-box small,
.chat-header small,
.profile-body p,
.group-item small,
.post-head small,
.contact-copy span {
  color: var(--muted);
}

.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-weight: 700;
  color: var(--primary-deep);
  margin: 8px 6px 12px;
}

.section-header button {
  border: none;
  background: #fff;
  border-radius: 10px;
  width: 28px;
  height: 28px;
  color: var(--primary-deep);
  box-shadow: 0 6px 14px rgba(15, 23, 42, 0.08);
}

.contact-list,
.group-item {
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.contact-item,
.group-item {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 10px 10px;
  border-radius: 16px;
  background: rgba(255, 255, 255, 0.38);
  border: 1px solid rgba(120, 86, 32, 0.06);
}

.contact-item:hover,
.group-item:hover {
  background: rgba(255, 255, 255, 0.7);
}

.avatar {
  width: 42px;
  height: 42px;
  border-radius: 14px;
  display: grid;
  place-items: center;
  color: white;
  font-weight: 700;
}

.avatar.large {
  width: 54px;
  height: 54px;
  border-radius: 18px;
}

.avatar.small {
  width: 36px;
  height: 36px;
  border-radius: 12px;
  font-size: 0.8rem;
}

.contact-copy {
  flex: 1;
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.contact-copy strong,
.group-item strong,
.post-head strong,
.chat-header strong,
.profile-body h3 {
  display: block;
  color: var(--text);
}

.badge,
.status-pill,
.mini-tag,
.dot-live {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border-radius: 999px;
  font-size: 0.7rem;
  font-weight: 700;
}

.badge {
  min-width: 24px;
  height: 24px;
  background: var(--primary);
  color: white;
  padding: 0 8px;
}

.group-dot {
  width: 12px;
  height: 12px;
  border-radius: 50%;
  box-shadow: 0 0 0 3px rgba(255, 255, 255, 0.7);
}

.main-panel {
  padding: 18px;
}

.topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18px;
  margin-bottom: 18px;
}

.eyebrow {
  margin: 0 0 6px;
  text-transform: uppercase;
  letter-spacing: 0.12em;
  font-size: 0.72rem;
  color: var(--primary);
  font-weight: 700;
}

.topbar h1 {
  margin: 0;
  font-size: clamp(1.9rem, 3vw, 2.8rem);
  color: var(--primary-deep);
}

.topbar-actions {
  display: flex;
  align-items: center;
  gap: 10px;
}

.ghost-button,
.primary-button,
.composer button {
  border: none;
  border-radius: 14px;
  padding: 0.8rem 1.1rem;
  font-weight: 700;
}

.ghost-button {
  background: white;
  color: var(--primary-deep);
  border: 1px solid rgba(120, 86, 32, 0.06);
}

.profile-pill {
  width: 42px;
  height: 42px;
  display: grid;
  place-items: center;
  border-radius: 50%;
  background: linear-gradient(135deg, var(--secondary), #0ea5a4);
  color: white;
  font-weight: 700;
}

.welcome-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18px;
  padding: 20px 22px;
  background: linear-gradient(135deg, rgba(217, 119, 6, 0.12), rgba(15, 118, 110, 0.14));
  border-radius: 24px;
  border: 1px solid rgba(120, 86, 32, 0.08);
  margin-bottom: 18px;
}

.welcome-card h2 {
  margin: 8px 0 0;
  max-width: 500px;
  font-size: clamp(1.4rem, 2vw, 2rem);
  color: var(--primary-deep);
}

.mini-tag {
  background: rgba(15, 118, 110, 0.12);
  color: var(--secondary);
  padding: 0.4rem 0.75rem;
}

.primary-button {
  background: linear-gradient(135deg, var(--primary), #f59e0b);
  color: white;
  box-shadow: 0 12px 20px rgba(180, 83, 9, 0.2);
}

.primary-button.alt {
  width: 100%;
}

.clock-section {
  background: rgba(255, 255, 255, 0.32);
  border: 1px solid rgba(120, 86, 32, 0.08);
  border-radius: 24px;
  padding: 15px 16px 18px;
  margin-bottom: 18px;
}

.clock-header {
  margin-top: 0;
}

.dot-live {
  background: rgba(22, 163, 74, 0.12);
  color: #15803d;
  padding: 0.35rem 0.7rem;
}

.timezone-grid {
  display: grid;
  grid-template-columns: repeat(5, minmax(100px, 1fr));
  gap: 12px;
}

.timezone-card {
  background: linear-gradient(135deg, rgba(255, 255, 255, 0.9), rgba(255, 246, 237, 0.7));
  border: 1px solid rgba(120, 86, 32, 0.06);
  border-radius: 18px;
  padding: 14px 12px;
}

.timezone-city {
  font-weight: 700;
  color: var(--primary-deep);
}

.timezone-time {
  margin-top: 8px;
  font-size: clamp(1.2rem, 2vw, 1.8rem);
  font-weight: 800;
  color: var(--text);
}

.timezone-date {
  margin-top: 4px;
  color: var(--muted);
  font-size: 0.8rem;
}

.chat-window {
  background: rgba(255, 255, 255, 0.42);
  border: 1px solid rgba(120, 86, 32, 0.08);
  border-radius: 24px;
  overflow: hidden;
}

.chat-header {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 16px 18px;
  background: rgba(255, 255, 255, 0.5);
  border-bottom: 1px solid rgba(120, 86, 32, 0.06);
}

.messages {
  display: flex;
  flex-direction: column;
  gap: 16px;
  padding: 20px 18px;
  min-height: 250px;
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.3), rgba(248, 245, 239, 0.8));
}

.bubble {
  max-width: 70%;
  padding: 12px 14px;
  border-radius: 18px;
  line-height: 1.5;
}

.bubble.incoming {
  background: rgba(15, 118, 110, 0.08);
  color: var(--text);
  border-top-left-radius: 6px;
}

.bubble.outgoing {
  background: linear-gradient(135deg, #d97706, #f59e0b);
  color: white;
  align-self: flex-end;
  border-top-right-radius: 6px;
}

.composer {
  display: flex;
  gap: 12px;
  border-top: 1px solid rgba(120, 86, 32, 0.06);
  padding: 14px 18px 18px;
  background: rgba(255, 255, 255, 0.4);
}

.composer input {
  flex: 1;
  border: 1px solid rgba(120, 86, 32, 0.08);
  background: rgba(255, 255, 255, 0.8);
  border-radius: 14px;
  padding: 0.9rem 1rem;
  color: var(--muted);
}

.composer button {
  background: var(--secondary);
  color: white;
  min-width: 110px;
}

.right-panel {
  padding: 18px 16px;
  display: flex;
  flex-direction: column;
  gap: 18px;
}

.profile-card,
.stats-card,
.posts-card {
  background: rgba(255, 255, 255, 0.4);
  border: 1px solid rgba(120, 86, 32, 0.08);
  border-radius: 22px;
  overflow: hidden;
}

.cover {
  height: 110px;
  background: linear-gradient(135deg, rgba(217, 119, 6, 0.85), rgba(15, 118, 110, 0.8));
}

.profile-body {
  padding: 0 18px 18px;
  position: relative;
}

.profile-avatar {
  width: 72px;
  height: 72px;
  border: 4px solid rgba(255, 255, 255, 0.92);
  border-radius: 24px;
  position: relative;
  margin: -36px 0 10px;
}

.profile-body h3 {
  margin: 0 0 6px;
  font-size: 1.35rem;
}

.profile-body p {
  margin: 0 0 14px;
}

.stats-card,
.posts-card {
  padding: 14px 14px 16px;
}

.status-pill {
  background: rgba(34, 197, 94, 0.12);
  color: #15803d;
  padding: 0.35rem 0.7rem;
}

.stats-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 10px;
  margin-top: 12px;
}

.stat-box {
  background: rgba(255, 255, 255, 0.48);
  border: 1px solid rgba(120, 86, 32, 0.06);
  border-radius: 16px;
  padding: 12px 10px;
  display: flex;
  flex-direction: column;
  gap: 6px;
}

.stat-box strong {
  font-size: 1.1rem;
  color: var(--primary-deep);
}

.stat-box span {
  color: var(--muted);
  font-size: 0.75rem;
}

.post-item {
  padding: 12px 0;
  border-top: 1px solid rgba(120, 86, 32, 0.06);
}

.post-item:first-of-type {
  border-top: none;
}

.post-head {
  display: flex;
  align-items: center;
  gap: 10px;
}

.post-item p {
  margin: 12px 0 10px;
  line-height: 1.6;
  color: var(--text);
}

.post-stats {
  display: flex;
  justify-content: space-between;
  gap: 10px;
  flex-wrap: wrap;
  color: var(--muted);
  font-size: 0.83rem;
}

.skeleton-grid {
  min-height: 110px;
  border-radius: 18px;
  background: linear-gradient(90deg, rgba(203, 213, 225, 0.4), rgba(255,255,255,0.4), rgba(203,213,225,0.4));
  background-size: 200% 100%;
  animation: shimmer 1.4s infinite linear;
}

@keyframes shimmer {
  0% { background-position: 200% 0; }
  100% { background-position: -200% 0; }
}

@media (max-width: 1120px) {
  .maghreb-shell {
    grid-template-columns: 280px 1fr;
  }

  .right-panel {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }
}

@media (max-width: 820px) {
  body {
    padding: 14px;
  }

  .maghreb-shell {
    grid-template-columns: 1fr;
    padding: 14px;
  }

  .right-panel {
    grid-template-columns: 1fr;
  }

  .timezone-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .welcome-card,
  .topbar {
    flex-direction: column;
    align-items: flex-start;
  }

  .topbar-actions {
    width: 100%;
    justify-content: space-between;
  }
}
